{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start in Firefox",
            "type": "firefox",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "reAttach": true
        },
        {
            "name": "Start in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Start in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}